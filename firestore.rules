rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /contactRequests/{contactId} {
      // El formulario institucional puede crear consultas, pero nunca leerlas.
      allow create: if request.auth != null || (
        request.resource.data.keys().hasAll(['name', 'email', 'message', 'status', 'source'])
        && request.resource.data.keys().hasOnly(['name', 'company', 'email', 'phone', 'message', 'createdAt', 'source', 'status'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'late4-web'
      );

      // La gestión completa queda reservada a usuarios de Firebase Auth.
      allow read, update, delete: if isAdmin();
    }

    match /crmCompanies/{companyId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /crmContacts/{contactId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
